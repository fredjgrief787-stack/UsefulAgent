# Anthropic API ключ (обязательно для Anthropic провайдера)
ANTHROPIC_API_KEY=your-api-key-here

# Anthropic Base URL (опционально)
# По умолчанию используется официальный https://api.anthropic.com
# Раскомментируйте и измените, если используете прокси или альтернативный endpoint
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# OpenAI API ключ (опционально, только если используется OpenAI провайдер)
# OPENAI_API_KEY=your-openai-key-here

# OpenAI Base URL (опционально, для совместимых API)
# По умолчанию используется официальный https://api.openai.com/v1
# OPENAI_BASE_URL=https://api.openai.com/v1

# OpenAI Model (опционально, по умолчанию gpt-4-turbo)
# OPENAI_MODEL=gpt-4-turbo
